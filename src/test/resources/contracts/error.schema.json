{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["timestamp", "status", "error", "message"],
  "properties": {
    "timestamp": { "type": "string" },
    "status": { "type": "integer" },
    "error": { "type": "string" },
    "message": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "additionalProperties": { "type": "string" } }
      ]
    }
  },
  "additionalProperties": false
}
