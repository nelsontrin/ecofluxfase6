{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "pontoColeta", "mensagem", "nivel", "dataHora", "resolvido"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "pontoColeta": {
      "type": "object",
      "required": ["id", "nome", "endereco", "capacidadeMaxima", "volumeAtual", "ativo"],
      "properties": { "id": { "type": "integer" }, "nome": { "type": "string" }, "endereco": { "type": "string" }, "capacidadeMaxima": { "type": "number" }, "volumeAtual": { "type": "number" }, "ativo": { "type": "boolean" }, "additionalProperties": false }
    },
    "mensagem": { "type": "string", "minLength": 1 },
    "nivel": { "type": "string", "enum": ["MEDIO", "ALTO"] },
    "dataHora": { "type": "string" },
    "resolvido": { "type": "boolean" }
  },
  "additionalProperties": false
}
