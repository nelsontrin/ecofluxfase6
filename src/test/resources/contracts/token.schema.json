{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["token", "tipo", "login"],
  "properties": {
    "token": { "type": "string", "minLength": 1 },
    "tipo": { "type": "string", "enum": ["Bearer"] },
    "login": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
